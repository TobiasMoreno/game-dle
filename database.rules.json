{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "activity": {
          "$date": {
            "$gameId": {
              ".validate": "newData.hasChildren(['date', 'gameId', 'won', 'attempts', 'completedAt']) && newData.child('date').val() === $date && newData.child('gameId').val() === $gameId && newData.child('won').isBoolean() && newData.child('attempts').isNumber() && newData.child('attempts').val() >= 0 && newData.child('attempts').val() <= 1000 && newData.child('completedAt').isNumber() && newData.child('completedAt').val() > 0",
              "date": {
                ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)"
              },
              "gameId": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
              },
              "won": {
                ".validate": "newData.isBoolean()"
              },
              "attempts": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
              },
              "completedAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "score": {
                ".validate": "!newData.exists() || newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      }
    },
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.child('hostId').val() === auth.uid",
        "code": {
          ".validate": "newData.isString() && newData.val() === $roomId && newData.val().matches(/^[A-Z2-9]{6}$/)"
        },
        "hostId": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },
        "status": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && (newData.val() === 'voting' || data.parent().child('hostId').val() === auth.uid)",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing' || newData.val() === 'voting' || newData.val() === 'roundResults' || newData.val() === 'finished'"
        },
        "round": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "totalRounds": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('round').val() === 0",
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
        },
        "categories": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('round').val() === 0",
          ".validate": "newData.hasChildren(['0', '1'])",
          "$categoryIndex": {
            ".validate": "$categoryIndex.matches(/^\\d$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
          }
        },
        "letter": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 1"
        },
        "durationMs": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 30000 && newData.val() <= 300000"
        },
        "votingDurationMs": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid && data.parent().child('round').val() === 0",
          ".validate": "newData.isNumber() && newData.val() >= 10000 && newData.val() <= 120000"
        },
        "startedAt": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "stoppedAt": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists()"
        },
        "votingStartedAt": {
          ".write": "auth != null && data.parent().child('players').child(auth.uid).exists()"
        },
        "votingCursor": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "votingWords": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "votingCategories": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && (data.exists() || data.parent().parent().child('round').val() === 0)",
            ".validate": "newData.hasChildren(['name', 'online', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 24"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "answers": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['values', 'submittedAt'])",
            "values": {
              "$categoryIndex": {
                ".validate": "$categoryIndex.matches(/^\\d$/) && newData.isString() && newData.val().length <= 40"
              }
            },
            "submittedAt": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "votes": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('status').val() === 'voting' && data.parent().parent().child('players').child(auth.uid).exists()",
            "$ownerId": {
              "$categoryIndex": {
                ".validate": "$categoryIndex.matches(/^\\d$/) && data.parent().parent().parent().parent().child('players').child($ownerId).exists() && (newData.val() === 'yes' || newData.val() === 'no')"
              }
            }
          }
        },
        "validationResults": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "roundScores": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "totals": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
